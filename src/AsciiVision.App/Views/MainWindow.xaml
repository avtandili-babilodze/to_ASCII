<Window x:Class="AsciiVision.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:AsciiVision.Rendering.Preview;assembly=AsciiVision.Rendering"
        xmlns:controls="clr-namespace:AsciiVision.App.Controls"
        Title="ASCII Vision"
        Width="1480" Height="920" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding StartCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopCommand}" />
        <KeyBinding Key="F8" Command="{Binding PauseResumeCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveScreenshotCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyTextCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="276" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ============================== LEFT: sources & styles ============================== -->
            <Border Grid.Column="0" Style="{StaticResource SidePanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,16,16,18">
                        <DockPanel Margin="0,0,0,4">
                            <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentSubtleBrush}"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" DockPanel.Dock="Left">
                                <TextBlock Text="@" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ASCII Vision" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Real-time ASCII video engine" Style="{StaticResource Caption}" FontSize="11.5" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="SOURCE" Style="{StaticResource SectionHeader}" />
                        <UniformGrid Columns="4" Margin="-3,0">
                            <RadioButton Style="{StaticResource TileButton}" ToolTip="Capture an entire monitor"
                                         IsChecked="{Binding SelectedSourceKind, Converter={StaticResource EnumToBool}, ConverterParameter=Screen}" AutomationProperties.Name="Screen source">
                                <StackPanel>
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center" />
                                    <TextBlock Text="Screen" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource TileButton}" ToolTip="Capture a single application or game window"
                                         IsChecked="{Binding SelectedSourceKind, Converter={StaticResource EnumToBool}, ConverterParameter=Window}" AutomationProperties.Name="Window source">
                                <StackPanel>
                                    <TextBlock Text="&#xE737;" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center" />
                                    <TextBlock Text="Window" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource TileButton}" ToolTip="Play a local MP4 or other video file"
                                         IsChecked="{Binding SelectedSourceKind, Converter={StaticResource EnumToBool}, ConverterParameter=Video}" AutomationProperties.Name="MP4 source">
                                <StackPanel>
                                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center" />
                                    <TextBlock Text="MP4" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource TileButton}" ToolTip="Built-in animated test pattern"
                                         IsChecked="{Binding SelectedSourceKind, Converter={StaticResource EnumToBool}, ConverterParameter=TestPattern}" AutomationProperties.Name="Test pattern source">
                                <StackPanel>
                                    <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center" />
                                    <TextBlock Text="Test" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <!-- Screen -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectedSourceKind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Screen}">
                            <TextBlock Text="Display" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                                        Command="{Binding RefreshSourcesCommand}" ToolTip="Refresh displays and windows" AutomationProperties.Name="Refresh displays" />
                                <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="DisplayName" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Window -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectedSourceKind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Window}">
                            <TextBlock Text="Window" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                                        Command="{Binding RefreshSourcesCommand}" ToolTip="Refresh window list" AutomationProperties.Name="Refresh windows" />
                                <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="DisplayName"
                                          MaxDropDownHeight="420" />
                            </DockPanel>
                            <Button Style="{StaticResource FlatButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    Command="{Binding PickWithSystemPickerCommand}" AutomationProperties.Name="Pick with Windows picker" ToolTip="Use the Windows capture picker">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Pick with Windows picker…" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentHoverBrush}"
                                       Visibility="{Binding PickedItemName, Converter={StaticResource NullToVisibility}}">
                                <Run Text="Picked:" /> <Run Text="{Binding PickedItemName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                       Text="Protected video, minimized windows and some exclusive-fullscreen games cannot be captured." />
                        </StackPanel>

                        <!-- Video -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding SelectedSourceKind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Video}">
                            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Command="{Binding BrowseVideoCommand}" AutomationProperties.Name="Open video">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Open video…" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="0,8,0,0" Text="{Binding VideoFileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding VideoPath}" Visibility="{Binding VideoPath, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding VideoInfoText}" Style="{StaticResource Caption}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}"
                                       Text="Tip: drop a video file anywhere on the window."
                                       Visibility="{Binding VideoPath, Converter={StaticResource InverseNullToVisibility}}" />
                            <CheckBox Margin="0,8,0,0" Content="Loop playback" IsChecked="{Binding LoopVideo}" />
                        </StackPanel>

                        <!-- Test pattern -->
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Caption}"
                                   Visibility="{Binding SelectedSourceKind, Converter={StaticResource EnumToVisibility}, ConverterParameter=TestPattern}"
                                   Text="An animated 1280×720 pattern at 60 FPS for trying styles and measuring performance without a capture source." />

                        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource DangerSubtleBrush}"
                                Visibility="{Binding IsCaptureSupported, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding CaptureUnsupportedReason}" TextWrapping="Wrap" FontSize="12" Foreground="#FFFFB4AE" />
                        </Border>

                        <CheckBox Margin="0,12,0,0" Content="Hide ASCII Vision from capture" IsChecked="{Binding ExcludeAppFromCapture}"
                                  IsEnabled="{Binding CanExcludeFromCapture}"
                                  ToolTip="Prevents the 'infinite mirror' when capturing the monitor this window is on. While enabled, this window is also invisible to other screen recorders and screen sharing." />
                        <CheckBox Margin="0,6,0,0" Content="Capture mouse cursor" IsChecked="{Binding CaptureCursor}" IsEnabled="{Binding CanToggleCursor}"
                                  ToolTip="Applies the next time capture starts." />

                        <TextBlock Text="ASCII STYLE" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource SegmentTrack}">
                            <UniformGrid Columns="4">
                                <RadioButton Style="{StaticResource SegmentButton}" Padding="1,6" FontSize="12" Content="Detailed"
                                             IsChecked="{Binding Style, Converter={StaticResource EnumToBool}, ConverterParameter=Detailed}"
                                             ToolTip="Shape matching: picks the character whose shape fits the light and dark inside each cell (sharpest contours and faces)" />
                                <RadioButton Style="{StaticResource SegmentButton}" Padding="1,6" FontSize="12" Content="Standard"
                                             IsChecked="{Binding Style, Converter={StaticResource EnumToBool}, ConverterParameter=Standard}" ToolTip="Brightness shading with the character ramp" />
                                <RadioButton Style="{StaticResource SegmentButton}" Padding="1,6" FontSize="12" Content="Outline"
                                             IsChecked="{Binding Style, Converter={StaticResource EnumToBool}, ConverterParameter=Outline}" ToolTip="Edge detection with | / \ - _ +" />
                                <RadioButton Style="{StaticResource SegmentButton}" Padding="1,6" FontSize="12" Content="Hybrid"
                                             IsChecked="{Binding Style, Converter={StaticResource EnumToBool}, ConverterParameter=Hybrid}" ToolTip="Shading plus outlines" />
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="COLOR" Style="{StaticResource SectionHeader}" />
                        <UniformGrid Columns="2" Margin="-3,0">
                            <RadioButton Style="{StaticResource TileButton}" IsChecked="{Binding ColorMode, Converter={StaticResource EnumToBool}, ConverterParameter=White}" AutomationProperties.Name="White colors">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="@" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="White" Margin="0,0,7,0" />
                                    <TextBlock Text="White" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource TileButton}" IsChecked="{Binding ColorMode, Converter={StaticResource EnumToBool}, ConverterParameter=Green}" AutomationProperties.Name="Green colors">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="@" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="#FF33FF66" Margin="0,0,7,0" />
                                    <TextBlock Text="Green" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource TileButton}" IsChecked="{Binding ColorMode, Converter={StaticResource EnumToBool}, ConverterParameter=Original}" AutomationProperties.Name="Original colors">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Margin="0,0,7,0">
                                        <Run Text="@" Foreground="#FFFF6B6B" /><Run Text="@" Foreground="#FF6BCB77" /><Run Text="@" Foreground="#FF4D96FF" />
                                    </TextBlock>
                                    <TextBlock Text="Original" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource TileButton}" IsChecked="{Binding ColorMode, Converter={StaticResource EnumToBool}, ConverterParameter=Custom}" AutomationProperties.Name="Custom colors">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="@" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Margin="0,0,7,0"
                                               Foreground="{Binding ForegroundHex, Converter={StaticResource HexToBrush}}" />
                                    <TextBlock Text="Custom" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock Text="OUTPUT" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource SegmentTrack}">
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource SegmentButton}" Content="App"
                                             IsChecked="{Binding DisplayMode, Converter={StaticResource EnumToBool}, ConverterParameter=App}" ToolTip="Preview inside this window" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Console"
                                             IsChecked="{Binding DisplayMode, Converter={StaticResource EnumToBool}, ConverterParameter=Console}" ToolTip="Render in a real console window" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Both"
                                             IsChecked="{Binding DisplayMode, Converter={StaticResource EnumToBool}, ConverterParameter=Both}" ToolTip="App preview and console at the same time" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Margin="0,7,0,0" Text="{Binding ConsoleStatus}" Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================== CENTER: preview ============================== -->
            <Grid Grid.Column="1" Margin="12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,2,0,10" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceTitle}" FontSize="15" FontWeight="SemiBold" MaxWidth="460" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="4" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentTrack}" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" Width="58" ToolTip="Fit the preview to the window (glyphs are rasterized at the fitted size)"
                                         IsChecked="{Binding PreviewFit, Converter={StaticResource EnumToBool}, ConverterParameter=Fit}" AutomationProperties.Name="Fit">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9A6;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0" />
                                    <TextBlock Text="Fit" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentButton}" Width="58" ToolTip="Actual size: render at the configured font size"
                                         IsChecked="{Binding PreviewFit, Converter={StaticResource EnumToBool}, ConverterParameter=ActualSize}" AutomationProperties.Name="Actual size">
                                <TextBlock Text="1:1" />
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource PanelRadius}" ClipToBounds="True">
                    <Grid>
                        <preview:AsciiPreviewControl x:Name="PreviewControl" FitMode="{Binding PreviewFit}" Margin="6" />

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding HasContent, ElementName=PreviewControl, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Left" xml:space="preserve">   ___   _____ _____ _____ _____
  / _ \ /  ___/  __ \_   _|_   _|
 / /_\ \\ `--.| /  \/ | |   | |
 |  _  | `--. \ |     | |   | |
 | | | |/\__/ / \__/\_| |_ _| |_
 \_| |_/\____/ \____/\___/ \___/  VISION</TextBlock>
                            <TextBlock Margin="0,26,0,0" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Choose a source, pick a style, then press Start." />
                            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Caption}" TextAlignment="Center"
                                       Text="Screen · Window · MP4 · Test pattern   —   F5 start, Shift+F5 stop, F8 pause" />
                        </StackPanel>

                        <!-- Console-only hint -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Padding="10,6" CornerRadius="6" Background="#E6262930"
                                IsHitTestVisible="False"
                                Visibility="{Binding DisplayMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Console}">
                            <TextBlock Text="Console-only output: the app preview is not updated." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Waiting hint -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" Padding="14,9" CornerRadius="8"
                                Background="#E6262930" MaxWidth="620" Visibility="{Binding WaitingMessage, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding WaitingMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                        </Border>

                        <!-- Notification banner -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16" MaxWidth="720" CornerRadius="8"
                                Background="#F2202328" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                Visibility="{Binding NotificationText, Converter={StaticResource NullToVisibility}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="8,0,0,8" Background="{Binding NotificationSeverity, Converter={StaticResource SeverityToBrush}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="&#xE711;" AutomationProperties.Name="Dismiss notification" FontSize="11" Margin="4"
                                        VerticalAlignment="Center" Command="{Binding DismissNotificationCommand}" ToolTip="Dismiss" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Show in folder" Padding="10,4" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding ShowNotificationPathCommand}"
                                        Visibility="{Binding NotificationPath, Converter={StaticResource NullToVisibility}}" />
                                <TextBlock Text="{Binding NotificationText}" TextWrapping="Wrap" Margin="12,9,6,9" VerticalAlignment="Center" FontSize="12.5" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Transport -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" ToolTip="Start (F5)" AutomationProperties.Name="Play" Padding="12,7"
                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                                <TextBlock Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding PauseResumeCommand}" ToolTip="Pause / resume (F8)" AutomationProperties.Name="Pause or Resume playback" Padding="12,7"
                                Visibility="{Binding IsIdle, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PauseResumeIcon}" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding PauseResumeLabel}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE71A;" AutomationProperties.Name="Stop playback" Margin="6,0,0,0" Padding="10,8"
                            Command="{Binding StopCommand}" ToolTip="Stop (Shift+F5)" />
                    <Slider x:Name="Timeline" Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Minimum="0"
                            Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" IsMoveToPointEnabled="True"
                            SmallChange="1" LargeChange="10"
                            Visibility="{Binding IsVideoSource, Converter={StaticResource BoolToVisibility}}"
                            PreviewMouseLeftButtonDown="OnTimelineMouseDown" PreviewMouseLeftButtonUp="OnTimelineMouseUp"
                            IsEnabled="{Binding IsActive}" AutomationProperties.Name="Playback position" />
                    <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding IsVideoSource, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>

            <!-- ============================== RIGHT: settings ============================== -->
            <Border Grid.Column="2" Style="{StaticResource SidePanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,6,16,18">
                        <TextBlock Text="RESOLUTION" Style="{StaticResource SectionHeader}" Margin="0,12,0,8" />
                        <TextBlock Text="Character density" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding QualityPresets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Preset}" Margin="0,0,0,12" />
                        <controls:LabeledSlider Label="ASCII grid width" Value="{Binding Columns}" Minimum="40" Maximum="400" Step="1" Format="0" Suffix=" cols" />
                        <CheckBox Content="Cell aspect from preview font" IsChecked="{Binding AutoCharacterAspect}" Margin="0,0,0,8"
                                  ToolTip="Use the measured height/width of the font's character cell for the preview, export and recording." />
                        <controls:LabeledSlider Label="Character aspect (manual / console)" Value="{Binding CharacterAspect}" Minimum="1" Maximum="3"
                                                Step="0.05" Format="0.00" ToolTip="Cell height ÷ width. Always used for the console, whose font is unknown." />
                        <controls:LabeledSlider Label="Font size" Value="{Binding FontSize}" Minimum="6" Maximum="32" Step="0.5" Format="0.#" Suffix=" px"
                                                ToolTip="Used by 1:1 preview, screenshots, recordings and native-size export." />
                        <TextBlock Text="Font" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}" />

                        <TextBlock Text="TONE" Style="{StaticResource SectionHeader}" />
                        <controls:LabeledSlider Label="Brightness" Value="{Binding Brightness}" Minimum="-1" Maximum="1" Step="0.01" Format="+0.00;-0.00;0.00" />
                        <controls:LabeledSlider Label="Contrast" Value="{Binding Contrast}" Minimum="0.2" Maximum="3" Step="0.01" Format="0.00" />
                        <controls:LabeledSlider Label="Gamma" Value="{Binding Gamma}" Minimum="0.2" Maximum="3" Step="0.01" Format="0.00" />
                        <controls:LabeledSlider Label="Local contrast (detail)" Value="{Binding LocalContrast}" Minimum="0" Maximum="1" Step="0.01" Format="0.00"
                                                ToolTip="Adaptive contrast (CLAHE): brings out faces, eyes and background texture in flat or dark areas. 0 = off." />
                        <CheckBox Content="Invert brightness mapping" IsChecked="{Binding InvertRamp}" Margin="0,0,0,10"
                                  ToolTip="The ramp direction follows the background automatically; this flips it." />
                        <DockPanel Margin="0,0,0,5">
                            <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding RampPresets}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding CharacterRamp, Mode=OneWay}"
                                      AutomationProperties.Name="Ramp preset" ToolTip="Ramp presets (Standard and Hybrid styles)"
                                      SelectionChanged="OnRampPresetChanged" />
                            <TextBlock Text="Character ramp" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE7A7;" Margin="6,0,0,0"
                                    Command="{Binding ResetRampCommand}" ToolTip="Restore the default ramp" AutomationProperties.Name="Reset character ramp" />
                            <TextBox Text="{Binding CharacterRamp, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                     AutomationProperties.Name="Character ramp" />
                        </DockPanel>
                        <TextBlock Text="{Binding RampError}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding RampError, Converter={StaticResource NullToVisibility}}" />

                        <TextBlock Text="DETAIL (DETAILED STYLE)" Style="{StaticResource SectionHeader}" />
                        <controls:LabeledSlider Label="Detail sharpness" Value="{Binding DetailSharpness}" Minimum="0" Maximum="1" Step="0.01" Format="0.00"
                                                ToolTip="Exaggerates the light/dark pattern inside each cell before matching glyph shapes: higher = crisper contours, lower = smoother shading." />
                        <TextBlock Text="Characters" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding DetailCharacterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding DetailCharacters}" AutomationProperties.Name="Detail characters" />

                        <TextBlock Text="EDGES" Style="{StaticResource SectionHeader}" />
                        <controls:LabeledSlider Label="Edge sensitivity" Value="{Binding EdgeSensitivity}" Minimum="0" Maximum="1" Step="0.01" Format="0.00" />
                        <controls:LabeledSlider Label="Edge thickness" Value="{Binding EdgeThickness}" Minimum="1" Maximum="4" Step="1" Format="0" Suffix=" px" />
                        <controls:LabeledSlider Label="Hybrid blend (edges ↔ shading)" Value="{Binding HybridBlend}" Minimum="0" Maximum="1" Step="0.01" Format="0.00" />

                        <TextBlock Text="COLOR CONFIGURATION" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Custom foreground" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Margin="0,0,8,0" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" Background="{Binding ForegroundHex, Converter={StaticResource HexToBrush}}" />
                            <TextBox Text="{Binding ForegroundHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                     AutomationProperties.Name="Custom foreground color" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ColorSwatches}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="20" Height="20" Margin="0,0,4,4" Cursor="Hand" ToolTip="{Binding}"
                                            Command="{Binding DataContext.SetForegroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="{Binding Converter={StaticResource HexToBrush}}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Background" Style="{StaticResource Caption}" Margin="0,8,0,5" />
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Margin="0,0,8,0" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" Background="{Binding BackgroundHex, Converter={StaticResource HexToBrush}}" />
                            <TextBox Text="{Binding BackgroundHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                     AutomationProperties.Name="Background color" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ColorSwatches}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="20" Height="20" Margin="0,0,4,4" Cursor="Hand" ToolTip="{Binding}"
                                            Command="{Binding DataContext.SetBackgroundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="{Binding Converter={StaticResource HexToBrush}}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="Tint cell backgrounds (Original colors)" IsChecked="{Binding ColorBackgroundFill}" Margin="0,6,0,8" />
                        <TextBlock Text="Screenshot background (blank = same as preview)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding ScreenshotBackgroundHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                 AutomationProperties.Name="Screenshot background color" />

                        <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionHeader}" />
                        <controls:LabeledSlider Label="Target FPS" Value="{Binding TargetFps}" Minimum="5" Maximum="144" Step="1" Format="0" />
                        <CheckBox Content="Automatic quality adjustment" IsChecked="{Binding AdaptiveQuality}"
                                  ToolTip="Lowers grid density gradually (never below 40 % or 40 columns) when frames exceed the time budget, and restores it when there is headroom." />

                        <TextBlock Text="CONSOLE" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Console grid" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding ConsoleSizeModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding ConsoleSizeMode}" Margin="0,0,0,10" />
                        <controls:LabeledSlider Label="Console columns" Value="{Binding ConsoleColumns}" Minimum="40" Maximum="400" Step="1" Format="0" Suffix=" cols"
                                                Visibility="{Binding ConsoleSizeMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Custom}" />
                        <TextBlock Text="Console colors" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding ConsoleColorDepths}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding ConsoleColorDepth}" />

                        <TextBlock Text="RECORDING" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding EncodingQualities}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding RecordingQuality}" ToolTip="Encoding quality" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding RecordingFpsOptions}" SelectedItem="{Binding RecordingFps}" ToolTip="Recording frame rate"
                                      ItemStringFormat="{}{0} fps" />
                        </Grid>

                        <TextBlock Text="PRESETS" Style="{StaticResource SectionHeader}" />
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource FlatButton}" Content="Reset" Margin="0,0,4,0" Command="{Binding ResetDefaultsCommand}" ToolTip="Reset to defaults" />
                            <Button Style="{StaticResource FlatButton}" Content="Save…" Margin="2,0" Command="{Binding SavePresetCommand}" ToolTip="Save preset (JSON)" />
                            <Button Style="{StaticResource FlatButton}" Content="Load…" Margin="4,0,0,0" Command="{Binding LoadPresetCommand}" ToolTip="Load preset (JSON)" />
                        </UniformGrid>

                        <TextBlock Text="FFMPEG" Style="{StaticResource SectionHeader}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Browse…" Padding="10,5" Margin="8,0,0,0"
                                    VerticalAlignment="Top" Command="{Binding BrowseFfmpegCommand}" />
                            <TextBlock Text="{Binding FfmpegStatus}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================== Toolbar ============================== -->
        <Border Grid.Row="1" Margin="12,10,12,0" Padding="8" Style="{StaticResource SidePanel}">
            <WrapPanel>
                <Button Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" Margin="0,0,6,0" AutomationProperties.Name="Start Capture">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Start Capture" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding StopCommand}" Margin="0,0,6,0" AutomationProperties.Name="Stop">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding PauseResumeCommand}" AutomationProperties.Name="Pause or Resume">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PauseResumeIcon}" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding PauseResumeLabel}" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolbarDivider}" />
                <Button Style="{StaticResource FlatButton}" Command="{Binding OpenConsoleCommand}" Margin="0,0,6,0" AutomationProperties.Name="Open Console">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Open Console" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding CloseConsoleCommand}" AutomationProperties.Name="Close Console">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Close Console" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolbarDivider}" />
                <Button Style="{StaticResource DangerButton}" Command="{Binding StartRecordingCommand}" Margin="0,0,6,0" AutomationProperties.Name="Start Recording">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" Margin="0,0,7,0" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="Start Recording" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding StopRecordingCommand}" AutomationProperties.Name="Stop Recording">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73B;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Stop Recording" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolbarDivider}" />
                <Button Style="{StaticResource FlatButton}" Command="{Binding ExportCommand}" Margin="0,0,6,0" AutomationProperties.Name="Export MP4" ToolTip="Convert the loaded video to an ASCII MP4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Export MP4…" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding SaveScreenshotCommand}" Margin="0,0,6,0" AutomationProperties.Name="Save Screenshot" ToolTip="Save the current frame as PNG or TXT (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Save Screenshot…" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Command="{Binding CopyTextCommand}" AutomationProperties.Name="Copy Text" ToolTip="Copy the current frame as plain text (Ctrl+Shift+C)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,7,0" />
                        <TextBlock Text="Copy Text" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ============================== Status bar ============================== -->
        <Border Grid.Row="2" Margin="12,8,12,10" Padding="12,6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Capture" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding CaptureFps}" Style="{StaticResource StatusValue}" />
                <TextBlock Text="Processing" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding ProcessingFps}" Style="{StaticResource StatusValue}" />
                <TextBlock Text="Preview" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding PreviewFps}" Style="{StaticResource StatusValue}" />
                <TextBlock Text="Console" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding ConsoleFps}" Style="{StaticResource StatusValue}" />
                <Rectangle Style="{StaticResource StatusDivider}" />
                <TextBlock Text="Frame time" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding ProcessingMs}" Style="{StaticResource StatusValue}" />
                <TextBlock Text="Grid" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding GridText}" Style="{StaticResource StatusValue}" />
                <TextBlock Text="Dropped" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding DroppedText}" Style="{StaticResource StatusValue}" />
                <Rectangle Style="{StaticResource StatusDivider}" />
                <TextBlock Text="Recording" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding RecordingText}" Style="{StaticResource StatusValue}" />
                <TextBlock Text="Source" Style="{StaticResource StatusLabel}" />
                <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource StatusValue}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
