<Window x:Class="AsciiVision.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export ASCII video"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="22,20,22,20">
        <TextBlock Text="Export ASCII video" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                   Text="Every frame is converted offline with the current style settings — nothing is dropped, and audio stays in sync." />

        <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding InputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding InputDetails}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SettingsSummary}" Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{StaticResource AccentHoverBrush}" />
            </StackPanel>
        </Border>

        <Grid Margin="0,16,0,0" IsEnabled="{Binding IsNotExporting}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Output file" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <DockPanel Grid.Row="0" Grid.Column="1">
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <TextBlock Grid.Row="2" Text="Resolution" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" DisplayMemberPath="Label" />

            <TextBlock Grid.Row="4" Text="Frame rate" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding SelectedFrameRate}" DisplayMemberPath="Label" />

            <TextBlock Grid.Row="6" Text="Quality (H.264)" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label" />

            <CheckBox Grid.Row="8" Grid.Column="1" Content="Include source audio (AAC)" IsChecked="{Binding IncludeAudio}" IsEnabled="{Binding HasAudio}" />
        </Grid>

        <ProgressBar Margin="0,20,0,0" Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" />
        <TextBlock Margin="0,8,0,0" Text="{Binding StatusText}" Style="{StaticResource Caption}" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="Show in folder" Command="{Binding ShowInFolderCommand}"
                    Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Close" Margin="8,0,0,0" Command="{Binding CloseCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Cancel export" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Export" Command="{Binding StartCommand}"
                    Visibility="{Binding IsExporting, Converter={StaticResource InverseBoolToVisibility}}" />
        </DockPanel>
    </StackPanel>
</Window>
