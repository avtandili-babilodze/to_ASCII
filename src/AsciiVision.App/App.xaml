<Application x:Class="AsciiVision.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AsciiVision.App.Converters"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumToBoolConverter x:Key="EnumToBool" />
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:NotificationSeverityToBrushConverter x:Key="SeverityToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
